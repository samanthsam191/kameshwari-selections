# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kameshwari
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kameshwari

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth ===
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === MSG91 (OTP) ===
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# === Razorpay ===
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# === Storage (Cloudflare R2 / AWS S3) ===
S3_BUCKET=kameshwari-assets
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
CDN_URL=https://cdn.kameshwariselections.com

# === Shiprocket ===
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password

# === WhatsApp Business API ===
WHATSAPP_API_URL=https://api.interakt.ai/v1
WHATSAPP_API_KEY=your-whatsapp-api-key

# === AI Services ===
PERFECT_CORP_API_KEY=your-perfect-corp-key
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# === Meilisearch ===
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-key

# === App ===
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
